# Copiază valorile în hPanel → Aplicația Node.js → Variabile de mediu. Nu pune fișierul .env în GitHub.
# Baza de date MySQL (hPanel → Baze de date → MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u000000000_fondmarket
DB_PASSWORD=
DB_NAME=u000000000_fondmarket

# Secret pentru sesiuni: un șir lung, aleator (minim 32 de caractere)
JWT_SECRET=

# Contul de administrator creat la prima pornire
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Claude API, pentru citirea ofertelor (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (hPanel → Emailuri). Hostinger: smtp.hostinger.com, port 465
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=oferte@domeniul-tau.ro
SMTP_PASSWORD=
MAIL_FROM="FondMarket <oferte@domeniul-tau.ro>"

# Adresa publică a platformei (folosită în linkurile din emailuri)
PUBLIC_URL=https://fondmarket.domeniul-tau.ro

# Date pentru proforma/plata prin ordin de plată
PAY_COMPANY=FondMarket SRL
PAY_IBAN=
